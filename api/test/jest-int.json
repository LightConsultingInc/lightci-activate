{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testRegex": "test/integration/.*\\.int\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!jose/|@modelcontextprotocol/)"
  ],
  "testEnvironment": "node",
  "testTimeout": 60000
}
