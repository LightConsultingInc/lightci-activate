# Server
PORT=3000
NODE_ENV=local

# Database (PostgreSQL) — matches docker-compose.yml at the repo root.
# In AWS these are replaced by the `DB` JSON secret injected by ECS.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=lightci_activate
# Force TLS on/off (defaults to on for any non-localhost host).
# DB_SSL=false
