# Server
PORT=4310
NODE_ENV=local
WEB_URL=http://localhost:3000
# ACTIVATE_EDITION=cloud        # cloud | self-hosted (self-hosted has no vendor leads, no demo seed)
# ACTIVATE_ROLE=all             # api | worker | all
# LOG_LEVEL=debug               # JSON lines on stdout; pretty-printed when NODE_ENV != production

# Encryption key for credentials stored in the database. Required in production; any string.
# ACTIVATE_SECRETS_KEY=
# ACTIVATE_SECRETS_KEY_PREVIOUS=   # comma-separated old keys, read-only, while rotating

# Database (PostgreSQL) — matches docker-compose.yml at the repo root.
DB_HOST=localhost
DB_PORT=5439
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=lightci_activate
# DB_SSL_MODE=verify-full       # disable | require | verify-ca | verify-full (default: disable for localhost, verify-full otherwise)
# DB_SSL_CA_FILE=               # CA bundle for verify-*; RDS hosts use the bundled AWS CA automatically
# MIGRATIONS_RUN_ON_BOOT=true   # default: on outside production; production runs `activate migrate` as a step

# People with these email domains get the cross-organisation "lead" role (cloud default: lightci.com; self-hosted default: none)
# LEAD_EMAIL_DOMAINS=lightci.com

# WorkOS (shared LightCI test environment)
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...

# AI
AI_PROVIDER=live            # live | mock
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-sonnet-5
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime

# Skill library (local clone of the client marketplace repo)
LIBRARY_REPO_PATH=../marketplace
# GITHUB_TOKEN=            # when set, Promoter opens real PRs
# GITHUB_REPO=owner/name

# Claude Enterprise (optional; seeded data stands in when unset)
# CLAUDE_COMPLIANCE_API_KEY=
# CLAUDE_ENTERPRISE_API_KEY=
# CLAUDE_ANALYTICS_API_KEY=
# CLAUDE_ADMIN_API_KEY=

# Seed the demo org on boot when the database is empty (cloud, non-production only; production needs ACTIVATE_ALLOW_SEED=true)
SEED_ON_BOOT=true

# Background jobs (pg-boss, in the database; no Redis). The worker role runs them; the api role only enqueues.
# WORKER_TIMEZONE=UTC            # timezone for the nightly schedules
# JOBS_SCHEMA=pgboss             # Postgres schema the queue lives in

# Marketplace repository. Production needs a remote; the local folder is for development and demos.
# LIBRARY_PROVIDER=github        # local | github | git
# LIBRARY_REPOSITORY=owner/name  # github provider (GITHUB_REPO still accepted)
# LIBRARY_GIT_TOKEN=             # token with contents + pull-request write (GITHUB_TOKEN still accepted)
# LIBRARY_REMOTE_URL=            # git provider: any remote URL
# LIBRARY_CLONES_DIR=            # where per-organisation clones live (default: next to LIBRARY_WORK_DIR)
# LIBRARY_ALLOW_LOCAL=true       # permit a local marketplace in production (single-node evaluation only)

# Identity provider. WorkOS (above) is the cloud default. Self-hosted installs can use their own
# OpenID Connect provider instead; Activate then runs its own OAuth server for the web app and Claude.
# AUTH_PROVIDER=workos            # workos | oidc
# AUTH_OIDC_ISSUER=https://login.example.com/realms/acme
# AUTH_OIDC_CLIENT_ID=activate
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_SCOPES=openid profile email
# AUTH_GROUPS_CLAIM=groups       # claim carrying group names or ids
# AUTH_ROLE_MAP={"admin":["IT-Admins"],"sponsor":["Activate-Sponsors"],"champion":["Claude-Champions"]}
# AUTH_WEB_CLIENT_ID=activate-web
# PUBLIC_API_URL=https://api.activate.example.com   # issuer of the tokens Activate mints; also the connector origin
