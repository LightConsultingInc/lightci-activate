# Copy this file to `infra/config/aws/prod.env`.
# `deploy.sh` sources it before terraform/release commands.
# Do not commit the copied `.env` file.

# Optional per-release image tag default.
# export IMAGE_TAG=latest

# Terraform variable overrides, e.g. extra secret env var mappings:
# export TF_VAR_extra_secrets='{SOME_API_KEY="arn:aws:secretsmanager:us-east-1:<account>:secret:lightci-activate-prod-some-api-key-XXXXXX"}'
